{
  "name": "host-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/host-e2e/src",
  "tags": [
    "type:e2e"
  ],
  "implicitDependencies": [
    "shell",
    "pricing-provider",
    "feature-two-provider",
    "feature-three-provider",
    "legacy-container"
  ],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright test --config apps/host-e2e/playwright.config.mts --project=chrome"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "e2e-all": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright test --config apps/host-e2e/playwright.config.mts"
      }
    },
    "e2e-container": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright test --config apps/host-e2e/playwright.container.config.mts --project=chrome"
      }
    },
    "e2e-container-all": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright test --config apps/host-e2e/playwright.container.config.mts"
      }
    }
  }
}