{
  "name": "host-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/host-e2e/src",
  "tags": ["type:e2e"],
  "implicitDependencies": ["elements-loader"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "build", "projects": ["elements-loader"] }],
      "options": {
        "command": "npx playwright test --config apps/host-e2e/playwright.config.mts --project=chrome"
      }
    },
    "lint": { "executor": "@nx/eslint:lint" },
    "e2e-all": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "build", "projects": ["elements-loader"] }],
      "options": {
        "command": "npx playwright test --config apps/host-e2e/playwright.config.mts"
      }
    }
  }
}
