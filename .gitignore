# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.nx/migrate-runs
.claude/worktrees
.claude/settings.local.json

.angular

# Windows/.NET outputs for the isolated real-IIS harness
legacy-harness/**/bin/
legacy-harness/**/obj/
legacy-harness/**/*.user

.nx/polygraph
# Published federation artifacts (build output). Any provider directory, so a
# new provider is covered without editing this file. The environment manifest
# at publish/ui/manifest.json IS tracked: it is the deployment control plane
# and the seed state the POC starts from.
publish/ui/*/

# Published legacy-container artifacts. Same reasoning as publish/ui/*/ above;
# unlike the federation manifest, legacy-container has no tracked control-plane
# file to preserve — see "Explicit Phase-1 decisions" in
# ANGULAR_SHELL_COEXISTENCE_PLAN.md.
publish/angular-shell/*/

# Playwright
/playwright-report
/test-results
/blob-report

__screenshots__/
