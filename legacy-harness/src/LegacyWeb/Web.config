<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- This is the reversible login-cutover switch for the isolated harness. -->
    <add key="LoginDestination" value="/AngularShell/" />
  </appSettings>

  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <customErrors mode="Off" />
    <authentication mode="Forms">
      <forms
        name=".LEGACYAUTH"
        loginUrl="/Login.aspx"
        path="/"
        timeout="20"
        slidingExpiration="true"
        protection="All"
        requireSSL="false"
        cookieless="UseCookies"
        cookieSameSite="Lax" />
    </authentication>
    <sessionState
      mode="StateServer"
      stateConnectionString="tcpip=127.0.0.1:42424"
      timeout="20"
      cookieless="UseCookies"
      cookieSameSite="Lax" />
    <!-- Fixed harness-only keys make auth deterministic across app-pool recycles. -->
    <machineKey
      validationKey="6A1F680BBF86B69396D6E45D86E65BA57FAED2225A206A95C3398BDBA839471D75DC9A5B55357D95626F2B17D821768E6F461AF7BD5E3D3BB4C335EF7D9A96A4"
      decryptionKey="C9D5FBC35165A971B0AD26907C1D8C1DCFE56D404174440234523980526AAA45"
      validation="HMACSHA256"
      decryption="AES" />
  </system.web>

  <location path="legacy-page.aspx">
    <system.web>
      <authorization>
        <deny users="?" />
      </authorization>
    </system.web>
  </location>

  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="default.asp" />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <modules runAllManagedModulesForAllRequests="false">
      <add name="LegacyPrincipalModule" type="LegacyWeb.Core.PrincipalModule, LegacyWeb.Core" />
    </modules>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Frame-Options" />
        <remove name="Content-Security-Policy" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Content-Security-Policy" value="frame-ancestors 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
    <httpErrors errorMode="DetailedLocalOnly" />
  </system.webServer>
</configuration>
