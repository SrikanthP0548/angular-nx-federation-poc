<%--
  Common Angular host master page (doc section 8.1).

  This is the production ASPX artifact. Exactly one stable shell-loader
  script reference lives here, so onboarding a new migrated page never means
  editing script tags across 100-200 .aspx files.

  Note the loader URL points at /ui/shell/current/ — a mutable version
  pointer with a short cache lifetime (doc section 11.3). The hashed chunks
  it pulls in are immutable and cached for a year.
--%>
<%@ Master Language="C#" %>
<!DOCTYPE html>
<html>
<head runat="server">
  <meta charset="utf-8" />
  <asp:ContentPlaceHolder ID="AngularHead" runat="server" />
  <link rel="stylesheet" href="/ui/shell/current/styles.css" />
</head>
<body>
  <form id="form1" runat="server">
    <asp:ContentPlaceHolder ID="AngularPageContent" runat="server" />
  </form>

  <%--
    Native Federation installs the shared-dependency import map at runtime
    via es-module-shims, so the shell entry must be loaded as "module-shim".
    A plain type="module" script bypasses the shim and every bare Angular
    specifier fails to resolve.
  --%>
  <script type="esms-options">{ "shimMode": true }</script>
  <script type="module" src="/ui/shell/current/polyfills.js"></script>
  <script type="module-shim" src="/ui/shell/current/main.js"></script>
</body>
</html>
